# Local configuration / Environments
.env
*.env
.venv
venv/
ENV/
env/
ActiveState.py

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Project outputs & temporary files
outputs/pointclouds/*
!outputs/pointclouds/.gitkeep
outputs/meshes/*
!outputs/meshes/.gitkeep
outputs/renders/*
!outputs/renders/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
outputs/test_extraction/*
!outputs/test_extraction/.gitkeep

# Data directories (keep structure & sample data, ignore large raw datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/ground_truth/*
!data/ground_truth/.gitkeep

# Allow committed sample test clips
!data/samples/controlled_test/*

# External / Large datasets & archives (exclude raw zips/bags/sqlite)
datasets/zurich_mav/*.zip
datasets/zurich_mav/*.bag
datasets/zurich_mav/*.tar.gz
*.zip
*.tar.gz
*.bag
*.db
*.db-journal
*.sqlite
*.sqlite3

# Large neural weights & point cloud files
*.pt
*.pth
*.ckpt
*.ply
*.las
*.bin
!data/samples/**/*.bin

# Scratch & temporary workspace
scratch/
task.md
colmap_workspace/
colmap.log
*.log

